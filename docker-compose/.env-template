# ─────────────────────────────────────────────
# Active profiles
# ─────────────────────────────────────────────
# Choose ONE media frontend: plex | jellyfin
# Choose ONE download client: transmission | transmission-openvpn
# Example: COMPOSE_PROFILES=jellyfin,transmission
COMPOSE_PROFILES=transmission,jellyfin

# ─────────────────────────────────────────────
# Paths
# ─────────────────────────────────────────────
# Root path for all media data (torrents + library).
# Subdirectory layout expected:
#   $DATA_PATH/torrents/       ← download destination
#   $DATA_PATH/torrents/watch/ ← drop .torrent files here for auto-import
#   $DATA_PATH/media/movies/   ← movie library
#   $DATA_PATH/media/tv/       ← TV show library
DATA_PATH=/path/to/media/data

# Root path for service config databases (preferably on a fast disk / SSD).
# Each service gets its own subdirectory: sonarr, radarr, prowlarr, etc.
CONFIG_PATH=/path/to/config/data/on/fast/disk

# ─────────────────────────────────────────────
# Timezone
# ─────────────────────────────────────────────
# Used by all services. Find your value at: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/London

# ─────────────────────────────────────────────
# OpenVPN (only required when using the transmission-openvpn profile)
# ─────────────────────────────────────────────
# Supported providers: https://haugene.github.io/docker-transmission-openvpn/supported-providers/
OPENVPN_PROVIDER=NORDVPN
OPENVPN_CONFIG=uk1234
OPENVPN_USERNAME=your_vpn_username
OPENVPN_PASSWORD=your_vpn_password
