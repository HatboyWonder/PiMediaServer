# Copy this file to `.env` in the same directory and fill it in.
# `.env` is gitignored, this template is not: keep credentials out of it.

# Which optional services to run, comma separated. Sonarr, Radarr and Prowlarr
# always run and are not listed here.
#   plex | jellyfin                        media server, pick at most one
#   transmission | transmission-openvpn    download client, pick at most one
#   seerr                                  request frontend for Plex/Jellyfin
#   flaresolverr                           Cloudflare solver for Prowlarr
COMPOSE_PROFILES=jellyfin,transmission,seerr

# Root of the media tree. Must be one filesystem so that Sonarr and Radarr can
# hardlink from torrents/ into media/ instead of copying. Run ./setup.sh after
# setting this to create the expected folder structure.
DATA_PATH=/path/to/media/data

# Application state: databases, artwork caches, logs. Put this on an SSD or
# similar, it sees a lot of small writes.
CONFIG_PATH=/path/to/config/data/on/fast/disk

# Owner of all files the containers create. `id -u` and `id -g` of the user
# that owns DATA_PATH and CONFIG_PATH.
PUID=1000
PGID=1000

# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Vienna

# --- profile: plex ---------------------------------------------------------
# One-time token from https://plex.tv/claim to bind a new server to your
# account. Expires after 4 minutes. Clear it again once the server is claimed.
# PLEX_CLAIM=

# --- profile: transmission-openvpn -----------------------------------------
# Required by this profile. Providers and config names are listed at
# https://haugene.github.io/docker-transmission-openvpn/supported-providers/
# OPENVPN_PROVIDER=
# OPENVPN_CONFIG=
# OPENVPN_USERNAME=
# OPENVPN_PASSWORD=
# Subnets that stay reachable while the VPN is up, so the web UI keeps working
# from your LAN.
# LOCAL_NETWORK=192.168.0.0/16
